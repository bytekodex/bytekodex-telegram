# One Kotlin compiler, on top of one of our JDK images.
#
# Kotlin ships as a plain zip of jars plus a launcher script, so every version from 1.2 to 2.4
# installs identically and the only thing that changes is the URL.
#
#   docker build -f Dockerfile.kotlin -t ghcr.io/bytekodex/kotlin:2.4.20 \
#     --build-arg BASE=ghcr.io/bytekodex/jdk:25 --build-arg URL=... --build-arg SHA256=... .

ARG BASE

FROM ${BASE} AS download
ARG URL
ARG SHA256

# Back to root only to install, then dropped again in the final stage.
USER root
RUN set -eux; \
    test -n "${URL}"; test -n "${SHA256}"; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl unzip; \
    curl -fsSL --retry 3 -o /tmp/kotlin.zip "${URL}"; \
    echo "${SHA256}  /tmp/kotlin.zip" | sha256sum -c -; \
    unzip -q /tmp/kotlin.zip -d /opt; \
    rm /tmp/kotlin.zip; \
    test -x /opt/kotlinc/bin/kotlinc; \
    # kotlinc colours its output through jansi, which extracts a native library into the temp
    # directory and runs it. Our temp directory is a noexec tmpfs, so that fails loudly on every
    # single compile — exit code stays zero, but the error lands in the user's output.
    #
    # Extracting it here instead solves it without giving anything up: --read-only makes the root
    # file system unwritable, not unexecutable, so jansi can load the library from a path it could
    # never have written to.
    mkdir -p /opt/jansi; \
    case "$(uname -m)" in \
        aarch64|arm64) native=Linux/arm64 ;; \
        x86_64|amd64) native=Linux/x86_64 ;; \
        *) native="" ;; \
    esac; \
    if [ -n "${native}" ]; then \
        cd /opt/jansi; \
        "${JAVA_HOME}/bin/jar" xf /opt/kotlinc/lib/kotlin-compiler.jar \
            "org/fusesource/jansi/internal/native/${native}/libjansi.so" || true; \
        found="$(find /opt/jansi -name libjansi.so | head -1)"; \
        [ -n "${found}" ] && mv "${found}" /opt/jansi/libjansi.so || true; \
        rm -rf /opt/jansi/org; \
    fi

FROM ${BASE}
USER root
COPY --from=download /opt/kotlinc /opt/kotlinc

# The launcher is a shell script that resolves JAVA_HOME, which the base image already sets.
ENV PATH=/opt/kotlinc/bin:$PATH

COPY --from=download /opt/jansi /opt/jansi

# kotlinc writes its temporary files under HOME. With no writable home it falls back to the JVM
# temp directory, which the caller mounts as a tmpfs. library.jansi.path points the native loader
# at the copy baked into the image, so it never tries to write one.
#
# JAVA_OPTS rather than JAVA_TOOL_OPTIONS: the launcher passes it straight to java, whereas
# JAVA_TOOL_OPTIONS makes the JVM announce itself on stderr, and that line would end up rendered
# as part of a compile error. The heap defaults the launcher would have set are kept.
ENV JAVA_OPTS="-Xmx512M -Xms128M -Djava.io.tmpdir=/tmp -Dlibrary.jansi.path=/opt/jansi"

USER 1000:1000
WORKDIR /work
CMD ["kotlinc", "-version"]
