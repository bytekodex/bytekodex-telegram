{
  "comment": [
    "Which toolchains the bot offers. This file holds only what a human has to decide; every",
    "download URL and checksum is resolved by `toolchainctl resolve` into lock.json.",
    "Adding a version means adding one entry here and re-running the resolver.",
    "",
    "Every Java release from 7 to 28 is here, not just the long-term ones. A non-LTS release is",
    "exactly where a feature first appeared, so it is what someone comparing bytecode across",
    "versions actually wants, and one more entry costs one more image.",
    "",
    "Both architectures are resolved. The bot runs on x64 servers and gets developed on arm64",
    "laptops, and a JDK tarball is per-architecture, so pinning one would make the other run under",
    "emulation. JDK 7 is x64 only: no vendor ever shipped an aarch64 build of it.",
    "",
    "jvm_target_max and release_floor describe what a compiler can emit. They are stated here",
    "rather than derived because only the compiler itself knows for sure, and `toolchainctl probe`",
    "corrects them against the real images."
  ],
  "jdk": {
    "operating_system": "linux",
    "architectures": ["x64", "aarch64"],
    "libc": "glibc",
    "archive_type": "tar.gz",
    "distributions": [
      "temurin",
      "zulu",
      "corretto",
      "liberica",
      "sap_machine",
      "oracle_open_jdk",
      "aoj",
      "microsoft",
      "dragonwell"
    ],
    "versions": [
      { "major": 7, "release_flag": false, "release_floor": 7 },
      { "major": 8, "release_flag": false, "release_floor": 8 },
      { "major": 9, "release_floor": 6 },
      { "major": 10, "release_floor": 6 },
      { "major": 11, "release_floor": 6 },
      { "major": 12, "release_floor": 7 },
      { "major": 13, "release_floor": 7 },
      { "major": 14, "release_floor": 7 },
      { "major": 15, "release_floor": 7 },
      { "major": 16, "release_floor": 7 },
      { "major": 17, "release_floor": 7 },
      { "major": 18, "release_floor": 7 },
      { "major": 19, "release_floor": 7 },
      { "major": 20, "release_floor": 8 },
      { "major": 21, "release_floor": 8 },
      { "major": 22, "release_floor": 8 },
      { "major": 23, "release_floor": 8 },
      { "major": 24, "release_floor": 8 },
      { "major": 25, "release_floor": 8 },
      { "major": 26, "release_floor": 8 },
      { "major": 27, "release_floor": 8, "allow_early_access": true },
      { "major": 28, "release_floor": 8, "allow_early_access": true, "preview": true }
    ]
  },
